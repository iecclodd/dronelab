# Required shared secret for every browser and MCP request. Generate with: openssl rand -base64 48
DRONELAB_RELAY_SECRET=replace-with-a-long-random-secret
# Exact browser origin(s), comma separated. Do not use * in production.
DRONELAB_ALLOWED_ORIGINS=https://dronelab.example.com
PORT=8787
# Relay bounds (all values are optional).
RELAY_SESSION_TTL_MS=900000
RELAY_COMMAND_TTL_MS=15000
RELAY_POLL_TIMEOUT_MS=25000
RELAY_MAX_QUEUE=32
RELAY_MAX_RESULT_BYTES=131072
RELAY_MAX_SESSIONS=100
# Operator-wide rolling provider-call budget. This in-memory protection resets on server restart.
DRONELAB_PROVIDER_CALLS_PER_HOUR=60
# Operator-wide rolling bridge-call budget. This also limits local policy/connectome inference.
DRONELAB_BRIDGE_CALLS_PER_HOUR=3600
# Server-side only provider credentials and configurable model IDs. Leave unset to disable providers.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional OpenAI-compatible server running on this same computer (Ollama or LM Studio).
# This URL is deliberately restricted to localhost/127.0.0.1/[::1] by the relay.
DRONELAB_LOCAL_MODEL_URL=http://127.0.0.1:11434/
DRONELAB_LOCAL_MODEL=
DRONELAB_LOCAL_MODEL_API_KEY=
# Optional local bridges. Each receives POST /v1/action and must return the documented state-v1/nav response.
# They are loopback-only, so a hosted relay cannot directly reach a model running on your laptop.
DRONELAB_CONNECTOME_URL=
DRONELAB_CONNECTOME_TOKEN=
DRONELAB_POLICY_URL=
DRONELAB_POLICY_TOKEN=
